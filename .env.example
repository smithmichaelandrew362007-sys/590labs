# 590 LABS® Environment Configuration
NODE_ENV=development
PORT=3000

# Application URL Configuration
# In production on Vercel, the application automatically runs on your deployed origin:
#   Vercel URL:    https://<your-project>.vercel.app
#   Custom Domain: https://590labs.com
#   Local Dev:     http://localhost:3000
# Optional: Set APP_URL if you want to enforce a specific canonical domain:
# APP_URL=https://590labs.com

# Authentication (JWT Secret Key)
# On Vercel, configure this in Project Settings -> Environment Variables
JWT_SECRET=590labs_production_super_secret_jwt_key_2026_urban_streetwear

# Razorpay Payment Gateway (Test Mode / Sandbox or Live Mode)
# Obtain credentials at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_590labs_dev
RAZORPAY_KEY_SECRET=590labs_secret_key_dev

# Google Sign-In (OAuth 2.0 Web Client)
# Obtain from Google Cloud Console -> APIs & Credentials -> Create OAuth 2.0 Client ID
# Add your deployed domain to Authorized JavaScript origins:
#   https://<your-project>.vercel.app
#   https://590labs.com (if custom domain connected)
GOOGLE_CLIENT_ID=

# ============================================================================
# OPTION C: PERSISTENT CLOUD STORAGE & CLOUD DATABASE (RECOMMENDED FOR VERCEL)
# ============================================================================
# 1. Cloudinary Persistent High-Res Image CDN (Free 25GB at https://cloudinary.com)
# When set, any image uploaded via the /admin panel is automatically stored on Cloudinary
# and served globally via ultra-fast CDN, surviving any serverless redeployments.
# Provide either CLOUDINARY_URL OR the three individual keys below:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# 2. Turso / libSQL Persistent Cloud Database (Free 9GB edge SQLite at https://turso.tech)
# TURSO_DATABASE_URL=libsql://your-db-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

