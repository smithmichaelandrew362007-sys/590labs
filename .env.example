# 590 LABS® Environment Configuration
NODE_ENV=development
PORT=3000

# Production Custom Domain Configuration
# When deployed to production, set APP_URL to your canonical domain:
APP_URL=https://590labs.com

# Authentication (Generate a strong 64+ char random secret in production)
JWT_SECRET=590labs_production_super_secret_jwt_key_2026_urban_streetwear

# Razorpay Payment Gateway (Test Mode / Sandbox or Live Mode)
# Obtain credentials at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_590labs_dev
RAZORPAY_KEY_SECRET=590labs_secret_key_dev

# Google Sign-In (OAuth 2.0 Web Client)
# Obtain from Google Cloud Console -> APIs & Credentials -> Create OAuth 2.0 Client ID
# In Google Cloud Console, add Authorized JavaScript origins:
#   Development: http://localhost:3000
#   Production:  https://590labs.com, https://www.590labs.com
# Authorized redirect URIs:
#   Production:  https://590labs.com, https://www.590labs.com
GOOGLE_CLIENT_ID=

